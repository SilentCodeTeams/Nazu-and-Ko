cli.error.prefix=Error: 
cli.error.unknownCommand=unknown command: {command}
cli.error.listen={flag}: expected IP:port, got "{value}"; example: {flag} 127.0.0.1:25565
cli.error.hostPort={flag}: expected host:port, got "{value}"; example: {flag} 127.0.0.1:25566
cli.error.hostEmpty={flag}: host must not be empty; got "{value}"
cli.error.port={flag}: port must be 0-65535, got "{value}"; example: {flag} 127.0.0.1:25566
cli.error.bind={flag}: expected IP:port, got "{value}"; example: --bind 127.0.0.1:0
cli.error.protocol=--protocol: expected auto|mc|http|tls|dns|ws|quic|raw, got "{value}"
cli.error.dropDirection=--drop-direction: expected c2s|s2c, got "{value}"
cli.error.duration=--duration: expected non-negative integer seconds, got "{value}"
cli.error.ruleMissing=--rule requires a value
cli.error.rule=--rule is invalid: {error}; example: --rule 'drop dir=c2s proto=http prefix=GET'
cli.error.proxyBind=proxy: cannot bind {address}: {error}; --listen must be an IP assigned to this machine (try 127.0.0.1:<port> or 0.0.0.0:<port>); ports below 1024 usually require privileges
cli.error.serveBind=serve: cannot bind {address}: {error}
cli.error.analyzeUsage=usage: nazuko analyze <file.pcap> [--hex] [--dissect] [--json] [--limit N]
cli.error.analyzeOpen=analyze: cannot open "{path}": {error}
cli.error.analyzeParse=analyze: cannot parse "{path}": {error}
cli.proxy.title=nazuko proxy
cli.proxy.listen=  listen: {value}
cli.proxy.target=  target: {value}
cli.proxy.rules=  rules: {value}
cli.proxy.bound=  bound: {value}
cli.serve.title=nazuko control server
cli.serve.bind=  bind: {value}
cli.serve.state=  state: {value}
cli.help=nazuko {version}\n\nUSAGE:\n  nazuko proxy [options]\n  nazuko serve [--bind <ip:port>] [--state <file>]\n  nazuko analyze <file.pcap> [--hex] [--dissect] [--json] [--limit N]\n  nazuko mcp\n  nazuko version [--json]\n\nLANGUAGE:\n  --lang <zh-CN|zh-TW|en>       interface language\n  --lang-file <path>            custom language file (highest priority)\n\nPROXY OPTIONS:\n  --listen <ip:port>            default 127.0.0.1:25565\n  --target <host:port>          default 127.0.0.1:25566\n  --protocol <mode>             auto | mc | http | tls | dns | ws | quic | raw\n  --pcap <file>                 write a real pcap\n  --duration <seconds>          stop accepting after N seconds\n  --drop-direction <dir>        drop c2s or s2c (still captured)\n  --rule <expr>                 repeatable drop/allow predicate\n  --quiet                       suppress console per-packet output\n  --json                        emit newline-delimited packet JSON\n\nRULE EXAMPLES:\n  --rule 'drop dir=c2s proto=mc contains=hello'\n  --rule 'drop proto=http prefix=GET'\n  --rule 'drop dir=s2c min_len=4096'
